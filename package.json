{
  "name": "prism-potions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prism Potions - a mobile-first liquid sort puzzle game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "cap:sync": "npm run build:native && cap sync",
    "assets:native": "node scripts/make-native-assets.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "ios:sync": "npm run build:native && cap sync ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "levels:build": "vite build --ssr src/core/precompute.ts --outDir .tmp --logLevel error && node .tmp/precompute.js",
    "levels:sweep": "vite build --ssr src/core/sweep.ts --outDir .tmp --logLevel error && node .tmp/sweep.js",
    "test:core": "vite build --ssr src/core/selftest.ts --outDir .tmp --logLevel error && node .tmp/selftest.js",
    "test:e2e": "node scripts/smoke.mjs",
    "test:layout": "node scripts/test-mobile-layout.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "perf": "node scripts/profile.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capgo/native-purchases": "^8.7.0",
    "capacitor-cloudsave": "file:native/capacitor-cloudsave",
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
