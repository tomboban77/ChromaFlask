{
  "name": "chromaflask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChromaFlask - a mobile-first liquid sort puzzle game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:core": "vite build --ssr src/core/selftest.ts --outDir .tmp --logLevel error && node .tmp/selftest.js",
    "test:e2e": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
