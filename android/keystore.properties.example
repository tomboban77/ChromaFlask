# Release signing for Prism Potions. Copy this file to `keystore.properties`
# (same folder) and fill in the two passwords you chose when the key was
# created. That copy is git-ignored and must never be committed or shared.
#
# Create the key once (see docs/NATIVE-BUILD.md "Release build"):
#   keytool -genkeypair -v -keystore D:/Grow/keys/prismpotions-upload.jks \
#           -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# NOTE: this is a Java .properties file, so paths use FORWARD slashes.
# A Windows backslash would be read as an escape character and break the path.

storeFile=D:/Grow/keys/prismpotions-upload.jks
storePassword=PUT-YOUR-KEYSTORE-PASSWORD-HERE
keyAlias=upload
keyPassword=PUT-YOUR-KEY-PASSWORD-HERE
